# SwiftChat Environment Configuration

# Application
APP_NAME=SwiftChat
APP_URL=http://localhost
APP_ENV=development
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=swiftchat
DB_USERNAME=root
DB_PASSWORD=

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@swiftchat.com
MAIL_FROM_NAME=SwiftChat

# WebSocket Server
WS_HOST=localhost
WS_PORT=8080
WS_HEALTH_PORT=8081

# Security
ENCRYPTION_KEY=
CSRF_SECRET=
JWT_SECRET=

# Admin
ADMIN_REGISTRATION_CODE=SWIFTCHAT_ADMIN_2024
ADMIN_NOTIFICATION_EMAIL=admin@swiftchat.com

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# Session
SESSION_LIFETIME=1800
SESSION_REGENERATE=300