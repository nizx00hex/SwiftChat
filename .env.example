#Application
APP_NAME=SwiftChat
APP_URL=http://localhost
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

#Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=swiftchat
DB_USERNAME=root
DB_PASSWORD=pass123

#Email Configuration (smtp)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=nisathnisath606@gmail.com
MAIL_PASSWORD=pass123
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@swiftchat.com
MAIL_FROM_NAME=SwiftChat

#WebSocket Server
WS_HOST=localhost
WS_PORT=8080
WS_MAX_CONNECTIONS=10000
WS_RATE_LIMIT=30
WS_HEALTH_PORT=8081

#Security
ENCRYPTION_KEY=
CSRF_SECRET=
JWT_SECRET

#Admin
ADMIN_REGISTRATION_CODE=SWIFTCHAT_ADMIN_2024

#Session
SESSION_LIFETIME=1800
SESSION_REGENERATE=300

#Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

#Logging
LOG_LEVEL=debug
LOG_RETENTION_DAYS=90

#File Uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
